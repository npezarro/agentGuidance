#!/usr/bin/env bash
# pre-commit hook for PUBLIC repos
# Scans staged changes for sensitive identifiers before allowing commit.
# Uses security-scan.sh from privateContext for pattern matching.
# Skips enforcement on private repos (checked via gh CLI).
#
# Install: bash hooks/install-hooks.sh

set -euo pipefail

SCAN_SCRIPT="$HOME/repos/privateContext/security-scan.sh"

if [ ! -x "$SCAN_SCRIPT" ]; then
  echo "WARNING: security-scan.sh not found at $SCAN_SCRIPT"
  echo "Skipping sensitive identifier check. Install privateContext to enable."
  exit 0
fi

# Only enforce on public repos (skip private repos)
REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
if [ -n "$REMOTE_URL" ] && command -v gh &>/dev/null; then
  REPO_SLUG=""
  if [[ "$REMOTE_URL" =~ github\.com[:/]([^/]+/[^/.]+) ]]; then
    REPO_SLUG="${BASH_REMATCH[1]%.git}"
  fi
  if [ -n "$REPO_SLUG" ]; then
    # Cache visibility: a network call on every commit is too slow, and the
    # answer changes about once in a repo's lifetime.
    VIS_CACHE="$(git rev-parse --git-dir)/.repo-visibility"
    if [ -f "$VIS_CACHE" ]; then
      VISIBILITY=$(cat "$VIS_CACHE")
    else
      VISIBILITY=$(gh repo view "$REPO_SLUG" --json visibility -q '.visibility' 2>/dev/null || echo "UNKNOWN")
      [ "$VISIBILITY" != "UNKNOWN" ] && echo "$VISIBILITY" > "$VIS_CACHE"
    fi
  fi
fi

# Scan only added/modified lines (not deletions) for sensitive patterns
SCAN_OUTPUT=$(git diff --cached | grep '^+' | grep -v '^+++' | "$SCAN_SCRIPT" 2>&1 || true)

if echo "$SCAN_OUTPUT" | grep -q "BLOCKED"; then
  echo ""
  echo "========================================="
  echo "  COMMIT BLOCKED: Sensitive identifiers  "
  echo "========================================="
  echo ""
  echo "$SCAN_OUTPUT"
  echo ""
  if [ "${VISIBILITY:-UNKNOWN}" = "PRIVATE" ]; then
    echo "Private repo, scanned anyway: repos can go public, and vendored files"
    echo "carry identifiers into other repos. Fix the violations above."
    echo "Deliberate exception: git commit --no-verify"
  else
    echo "This is a PUBLIC repo. Fix the violations above before committing."
  fi
  echo "See ~/repos/privateContext/sensitive-identifiers.md for replacement values."
  echo ""
  echo "To bypass (emergency only): git commit --no-verify"
  exit 1
fi

exit 0
